# =====================================================================
# Dream Valley School ERP - Environment Configuration Template (.env.example)
# Duplicate this file as .env and fill in your values
# =====================================================================

# --------------------------------------------------
# Application Configuration
# --------------------------------------------------
APP_NAME="Dream Valley School ERP"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/erp-dvs/
APP_TIMEZONE="Asia/Dhaka"

# --------------------------------------------------
# Database Connection (MySQL / MariaDB)
# --------------------------------------------------
DB_CONNECTION=mysqli
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_dvs
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

# --------------------------------------------------
# Redis Cache Configuration (radius cache)
# --------------------------------------------------
CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=0
REDIS_DATABASE=0
REDIS_PREFIX=dvs_
REDIS_SOCKET_TYPE=tcp

# --------------------------------------------------
# bKash Payment Gateway (Tokenized Checkout API v1.2.0)
# --------------------------------------------------
BKASH_STATUS=1
BKASH_SANDBOX=1
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# --------------------------------------------------
# Nagad Payment Gateway Configuration
# --------------------------------------------------
NAGAD_STATUS=1
NAGAD_SANDBOX=1
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# --------------------------------------------------
# Session Configuration
# --------------------------------------------------
SESSION_DRIVER=files
SESSION_COOKIE_NAME=ci_session
SESSION_EXPIRATION=7200
SESSION_SAVE_PATH=

# --------------------------------------------------
# Mail / SMTP Configuration
# --------------------------------------------------
MAIL_PROTOCOL=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@dreamvalley.edu.bd
MAIL_FROM_NAME="Dream Valley School"
